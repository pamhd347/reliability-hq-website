0:{"buildId":"gY_ycmc1yEnweXy_OyFzI","rsc":["$","$1","c",{"children":[["$","div",null,{"className":"bg-off-white","children":[["$","header",null,{"className":"bg-gradient-to-br from-slate-navy to-deep-teal text-white py-12 md:py-16","children":["$","div",null,{"className":"container-max px-4 sm:px-6 lg:px-8","children":["$","div",null,{"className":"max-w-4xl","children":[["$","nav",null,{"className":"flex items-center gap-2 text-sm text-white/60 mb-6","children":[["$","$L2",null,{"href":"/","className":"hover:text-white transition-colors","children":"Home"}],["$","span",null,{"children":"/"}],["$","$L2",null,{"href":"/blog","className":"hover:text-white transition-colors","children":"Blog"}],["$","span",null,{"children":"/"}],["$","span",null,{"className":"text-white/80","children":"RCM Basics"}]]}],["$","span",null,{"className":"inline-block text-sm font-semibold bg-white/20 px-3 py-1 rounded-full mb-4","children":"RCM Basics"}],["$","h1",null,{"className":"font-heading font-bold text-3xl md:text-4xl lg:text-5xl mb-6","children":"What is RCM? A Complete Guide for Maintenance Professionals"}],["$","div",null,{"className":"flex flex-wrap items-center gap-4 text-white/80","children":[["$","span",null,{"className":"flex items-center gap-2","children":[["$","svg",null,{"className":"w-5 h-5","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","strokeWidth":2,"d":"M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"}]}],"Reliability HQ"]}],["$","span",null,{"className":"flex items-center gap-2","children":[["$","svg",null,{"className":"w-5 h-5","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","strokeWidth":2,"d":"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"}]}],"15 January 2026"]}],["$","span",null,{"className":"flex items-center gap-2","chil